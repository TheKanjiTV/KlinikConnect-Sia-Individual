# Copy this file to .env.production and fill in the values before deploying.
# Generate APP_KEY with: openssl rand -base64 32
# (prefix the output with base64:), or:
# docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"

APP_NAME=KlinikConnect
APP_KEY=
APP_ENV=production
APP_DEBUG=false
APP_URL=https://klinik.example.com

# The public URL is also the frontend URL because nginx proxies /api to Laravel.
FRONTEND_URL=https://klinik.example.com
CORS_ALLOWED_ORIGINS=https://klinik.example.com

# Host(s) that the browser uses, without the scheme. Separate multiple hosts
# with commas. Include the port when the app is served on a non-default one
# (for local testing: localhost,localhost:8080,127.0.0.1,127.0.0.1:8080).
SANCTUM_STATEFUL_DOMAINS=klinik.example.com
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

# Port published by the web container. Put a TLS reverse proxy in front of it.
APP_PORT=8080

DB_DATABASE=klinik
DB_USERNAME=klinik
DB_PASSWORD=replace-with-a-long-password
DB_ROOT_PASSWORD=replace-with-another-long-password

# Demo accounts from DemoDataSeeder. Set to false and remove/change the demo
# users for a real deployment.
RUN_SEEDER=true

# Images published by .github/workflows/docker-publish.yml.
API_IMAGE=ghcr.io/thekanjitiv/klinikconnect-api:latest
WEB_IMAGE=ghcr.io/thekanjitiv/klinikconnect-web:latest
