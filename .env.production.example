# Copy this file to .env.production and fill in the values before deploying.
# Generate APP_KEY with: openssl rand -base64 32
# (prefix the output with base64:), or:
# docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"

APP_NAME=KlinikConnect
APP_KEY=
APP_ENV=production
APP_DEBUG=false
APP_URL=https://klinik.example.com

# The public URL is also the frontend URL because nginx proxies /api to Laravel.
FRONTEND_URL=https://klinik.example.com
CORS_ALLOWED_ORIGINS=https://klinik.example.com

# Host(s) that the browser uses, without the scheme. Separate multiple hosts
# with commas. Include the port when the app is served on a non-default one
# (for local testing: localhost,localhost:8080,127.0.0.1,127.0.0.1:8080).
SANCTUM_STATEFUL_DOMAINS=klinik.example.com
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

# Port published by the web container. Put a TLS reverse proxy in front of it.
APP_PORT=8080

DB_DATABASE=klinik
DB_USERNAME=klinik
DB_PASSWORD=replace-with-a-long-password
DB_ROOT_PASSWORD=replace-with-another-long-password

# Demo accounts from DemoDataSeeder are disabled by default. Enable only for
# an isolated demo environment; the seeded accounts share a known password.
RUN_SEEDER=false

# Images published by .github/workflows/docker-publish.yml.
API_IMAGE=ghcr.io/thekanjitiv/klinikconnect-api:latest
WEB_IMAGE=ghcr.io/thekanjitiv/klinikconnect-web:latest

# KlinikConnect credentials. Generate each secret with a cryptographic RNG.
PATIENT_APPOINTMENT_BASE_URL=https://klinik.example.com/api/v1
PATIENT_APPOINTMENT_OUTBOUND_API_KEY=
PATIENT_APPOINTMENT_INBOUND_API_KEY=
PATIENT_APPOINTMENT_WEBHOOK_SIGNING_SECRET=
PATIENT_APPOINTMENT_WEBHOOK_VERIFY_SECRET=
PATIENT_APPOINTMENT_WEBHOOK_URL=https://klinik.example.com/api/v1/integrations/webhook

# Set the recipient URL and its accepted credentials when the other team supplies them.
INTEGRATION_OUTBOUND_WEBHOOK_URL=
BILLING_ACCOUNTING_BASE_URL=http://54.206.187.155/api/v1
BILLING_ACCOUNTING_OUTBOUND_API_KEY=
BILLING_ACCOUNTING_INBOUND_API_KEY=
BILLING_ACCOUNTING_WEBHOOK_SIGNING_SECRET=
BILLING_ACCOUNTING_WEBHOOK_VERIFY_SECRET=
BILLING_ACCOUNTING_WEBHOOK_URL=http://54.206.187.155/api/integration/webhooks
BILLING_API_TOKEN=
HOSPITAL_EMR_BASE_URL=http://52.62.184.84:3000/api/v1
HOSPITAL_EMR_OUTBOUND_API_KEY=
HOSPITAL_EMR_INBOUND_API_KEY=
HOSPITAL_EMR_WEBHOOK_SIGNING_SECRET=
HOSPITAL_EMR_WEBHOOK_VERIFY_SECRET=
HOSPITAL_EMR_WEBHOOK_URL=http://52.62.184.84:3000/api/v1/webhooks/hospital-emr
EMR_API_TOKEN=
LAB_PHARMACY_BASE_URL=http://13.236.57.159
LAB_PHARMACY_OUTBOUND_API_KEY=
LAB_PHARMACY_INBOUND_API_KEY=
LAB_PHARMACY_WEBHOOK_SIGNING_SECRET=
LAB_PHARMACY_WEBHOOK_VERIFY_SECRET=
LAB_PHARMACY_WEBHOOK_URL=http://13.236.57.159/api/v1/webhooks/lab-pharmacy
LAB_PHARMACY_API_TOKEN=
